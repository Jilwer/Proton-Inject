CompileFlags:
  Remove:
    - -mno-direct-extern-access

---
If:
  PathMatch: windows/.*
CompileFlags:
  Add:
    - --target=x86_64-w64-mingw32
    - -std=c++23
    - -DWIN32_LEAN_AND_MEAN
    - -DNOMINMAX
    - -Iwindows/injector
    - -Iwindows/loader
  Compiler: x86_64-w64-mingw32-g++
  CompilationDatabase: None
